          <material><ambient>0.05 0.6 0.55 1</ambient></material>
        </visual>
        <!-- AprilTag 36h11 id 2. Local +Z verified as the face away from the wall. -->
        <visual name="tag">
          <pose>0 0 0.111 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
