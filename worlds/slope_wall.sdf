    <model name="grasp_object_cube">
      <pose>3.481 -0.9 1.540 0 1.2566 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00048</ixx><iyy>0.00048</iyy><izz>0.00048</izz>
