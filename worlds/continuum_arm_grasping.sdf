            <diffuse>0.1 0.32 0.62 1</diffuse>
            <specular>0.3 0.3 0.35 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Can on the middle shelf (shelf_3, top at z=1.2), toward the front -->
    <!-- edge of its 0.34m depth so it is reachable without the arm having -->
    <!-- to travel the full depth of the cubby. -->
    <model name="scenario_4_can">
      <pose>0 -10.92 1.29 0 0 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
