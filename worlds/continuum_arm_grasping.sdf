            <diffuse>0.1 0.32 0.62 1</diffuse>
            <specular>0.3 0.3 0.35 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_4_top_rail_back">
      <static>true</static>
      <pose>0 -11.17 2.15 0 0 0</pose>
      <link name="rail_link">
        <collision name="collision">
          <geometry><box><size>1.56 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
