          <material>
            <ambient>0.72 0.64 0.5 1</ambient>
            <diffuse>0.75 0.67 0.53 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Middle (3rd of 5) shelf - carries the can. -->
    <model name="scenario_4_shelf_3">
      <static>true</static>
      <pose>0 -11 1.185 0 0 0</pose>
      <link name="shelf_link">
        <collision name="collision">
          <geometry><box><size>1.56 0.34 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
