<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Four grasping scenarios for UAV + soft continuum-arm whole-body -->
  <!-- optimization experiments (see continuum_arm_whole_body_optimization_ -->
  <!-- final_summary.md). Each scenario is built so the desired end-effector -->
  <!-- task cannot be solved by the UAV alone or the arm alone: the -->
  <!-- optimizer must decide how to split the required motion between UAV -->
  <!-- pose and arm curvature (J_share / J_dex in the summary doc). -->
  <!-- -->
  <!-- Sizing assumptions used throughout (derived from the hillstar/ -->
  <!-- hillstar_continuum_arm_gripper models, see per-scenario comments -->
  <!-- below for how each is used): -->
  <!--   - UAV rotor-tip span: rotor hubs sit at (+/-0.28, +/-0.28) in -->
  <!--     hillstar_base/model.sdf, prop.stl half-width is 0.178m, so the -->
  <!--     UAV's on-axis (non-diagonal) rotor extent from body center is -->
  <!--     about 0.28+0.178 = 0.458m, and its worst-case (diagonal) extent -->
  <!--     is about 0.396+0.178 = 0.574m (span ~0.92-1.15m depending on -->
  <!--     direction). -->
  <!--   - Arm+gripper reach: hillstar_arm_clearance_stand/model.config -->
  <!--     documents the arm hanging 0.40m from its mount plus a 0.08533m -->
  <!--     gripper offset, i.e. ~0.45-0.48m of reach from the arm mount in -->
  <!--     any bending direction for the single-section constant-curvature -->
  <!--     arm. -->
  <!-- These are first-pass planning numbers, not measured flight margins - -->
  <!-- expect to retune opening/depth dimensions after flying the actual -->
  <!-- vehicle in each scenario. -->
  <world name="continuum_arm_grasping">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::ForceTorque" filename="gz-sim-forcetorque-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.75 0.82 0.9</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.58 0.56 0.5 1</ambient>
            <diffuse>0.58 0.56 0.5 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <!-- Bench stand at the vehicle's default spawn point (world origin), -->
    <!-- same purpose/derivation as in slope_wall.sdf: raises the vehicle's -->
    <!-- landing skids clear of the ground so hillstar_continuum_arm_gripper's -->
    <!-- own soft arm can settle into a true, unforced neutral hang instead -->
    <!-- of buckling against a flat floor. Scenarios are placed well away -->
    <!-- from here so the vehicle has open room to fly out to any of them. -->
    <include>
      <uri>model://hillstar_arm_clearance_stand</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- =================================================================== -->
    <!-- Scenario 1: shelf / recessed alcove, centered at (0, 8).           -->
    <!-- Approach direction is +Y (mouth faces south/-Y at y=8.0, back wall -->
    <!-- at y=8.55). Opening is 1.5m wide - comfortably wider than the -->
    <!-- UAV's ~0.92-1.15m rotor span so the vehicle can advance into the -->
    <!-- mouth - but the 0.55m depth to the can means covering the last -->
    <!-- ~0.3-0.45m to the can is cheaper/safer with the arm than by -->
    <!-- pushing the UAV body deep between the side walls, which is exactly -->
    <!-- the workload-sharing trade-off (J_share) the optimizer should -->
    <!-- resolve differently across mission phases (free flight -> approach -->
    <!-- -> contact). -->
    <!-- =================================================================== -->
    <model name="scenario_1_side_wall_left">
      <static>true</static>
      <pose>-0.79 8.275 0.95 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.08 0.55 1.3</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 0.55 1.3</size></box>
          </geometry>
          <material>
            <ambient>0.68 0.63 0.53 1</ambient>
            <diffuse>0.7 0.65 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_1_side_wall_right">
      <static>true</static>
      <pose>0.79 8.275 0.95 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.08 0.55 1.3</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 0.55 1.3</size></box>
          </geometry>
          <material>
            <ambient>0.68 0.63 0.53 1</ambient>
            <diffuse>0.7 0.65 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_1_back_wall">
      <static>true</static>
      <pose>0 8.59 0.975 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>1.9 0.08 1.45</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.9 0.08 1.45</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.56 0.48 1</ambient>
            <diffuse>0.62 0.58 0.5 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_1_shelf_floor">
      <static>true</static>
      <pose>0 8.29 0.88 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <box><size>1.4 0.48 0.04</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.4 0.48 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.3 0.18 1</ambient>
            <diffuse>0.5 0.33 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Can sits near the back of the shelf (0.09m clear of the back -->
    <!-- wall) so the full 0.46m mouth-to-can depth is relevant to reach. -->
    <model name="scenario_1_can">
      <pose>0 8.46 0.99 0 0 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.18</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.18</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
        <visual name="tag">
          <pose>0 0 0.061 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.028</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://tag_textures/materials/textures/tag_1_can.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- Scenario 2: 60-degree inclined wall, centered at (9, -6).          -->
    <!-- Built the same way as slope_wall.sdf's ramp - a flat panel pitched -->
    <!-- about Y - but starting from a panel whose face normal is +Z -->
    <!-- (horizontal) at zero pitch, so incline_from_horizontal == pose -->
    <!-- pitch directly: pitch = 1.0471976 rad = 60deg gives a surface -->
    <!-- normal of (sin60, 0, cos60) = (0.866, 0, 0.5), i.e. exactly 60deg -->
    <!-- off vertical/horizontal (verified numerically, see task notes). -->
    <!-- The can is given the *same* pitch as the panel so its cylinder -->
    <!-- axis is parallel to the surface normal, i.e. it "stands" on the -->
    <!-- slope. At 60deg, gravity's in-plane component (mg*sin60=0.866mg) -->
    <!-- exceeds what mu=1.5 friction alone reliably holds (needs -->
    <!-- mu > tan(60deg) = 1.73), so this scenario raises friction to 2.0 -->
    <!-- on both surfaces AND adds a small physical lip immediately -->
    <!-- downhill of the can as a mechanical stop - belt and suspenders -->
    <!-- against the can sliding off during settling. -->
    <!-- =================================================================== -->
    <model name="scenario_2_slope">
      <static>true</static>
      <pose>9 -6 0.7228 0 1.0471976 0</pose>
      <link name="slope_link">
        <collision name="collision">
          <geometry>
            <box><size>1.6 2.2 0.12</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.6 2.2 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.48 0.5 0.55 1</ambient>
            <diffuse>0.52 0.54 0.6 1</diffuse>
            <specular>0.2 0.2 0.22 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Small retaining lip immediately downhill of the can, fixed to the -->
    <!-- slope surface (same pitch), acting as a mechanical stop. -->
    <model name="scenario_2_lip">
      <static>true</static>
      <pose>8.9569 -6 0.9774 0 1.0471976 0</pose>
      <link name="lip_link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.15 0.06</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.15 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.31 0.34 1</ambient>
            <diffuse>0.32 0.33 0.36 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_2_can">
      <pose>8.9799 -6 1.0576 0 1.0471976 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.18</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.18</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
        <visual name="tag">
          <pose>0 0 0.061 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.028</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://tag_textures/materials/textures/tag_1_can.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- Scenario 3: can between a back wall and a front obstacle,          -->
    <!-- centered at (-9, -6). Approach direction is +Y: UAV approaches -->
    <!-- from the south (y < -6.75), passes the front obstacle -->
    <!-- (y in [-6.75,-6.45]), and the can sits on a pedestal just in front -->
    <!-- of the back wall (y=-5.9, wall inner face at y=-5.55). There are -->
    <!-- deliberately no side walls: the obstacle only blocks the direct -->
    <!-- line to the can, leaving open space to either side (>0.7m past -->
    <!-- the 1.0m-wide obstacle on a 2.4m-wide backdrop) so the UAV can -->
    <!-- reposition laterally around it, AND a 0.35m gap between the -->
    <!-- obstacle and the pedestal so the arm can reach through/around -->
    <!-- while the UAV stays further back - both strategies stay viable, -->
    <!-- which is the point of this scenario. -->
    <!-- =================================================================== -->
    <model name="scenario_3_back_wall">
      <static>true</static>
      <pose>-9 -5.5 1.15 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>2.4 0.1 1.9</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>2.4 0.1 1.9</size></box>
          </geometry>
          <material>
            <ambient>0.58 0.58 0.6 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="scenario_3_pedestal">
      <static>true</static>
      <pose>-9 -5.9 0.45 0 0 0</pose>
      <link name="pedestal_link">
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.4 0.9</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.4 0.9</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.42 0.42 0.44 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Front obstacle: simple box, bright/contrasting so it reads -->
    <!-- unambiguously as "the obstacle" against the neutral wall/pedestal. -->
    <model name="scenario_3_front_obstacle">
      <static>true</static>
      <pose>-9 -6.6 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 0.3 1.0</size></box>
          </geometry>
          <surface>
            <friction>
