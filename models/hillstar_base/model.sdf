<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hillstar_base'>
    <pose>0 0 0.30 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <velocity_decay/>
      <inertial>
        <mass>3.26</mass>
        <inertia>
          <ixx>0.0205</ixx>
          <iyy>0.0177</iyy>
          <izz>0.0225</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Collision split into the body block + the 2 landing skids -->
      <!-- separately (not one solid box spanning the full bounding envelope -->
      <!-- like the original placeholder, and not my first "fix" which just -->
      <!-- matched the full mesh bounding box either) - a single box filled in -->
      <!-- the open space between/under the skids where an attachment needs -->
      <!-- to operate, so anything placed under the UAV hit that solid slab -->
      <!-- instead of the true legs, making it rest far higher than it should. -->
      <!-- Verified directly from the mesh: legs are 2 thin skids (not 4), -->
      <!-- each spanning the full x range at a fixed y band, found by -->
      <!-- clustering outer-radius (>=0.10), low-z (<0) vertices by angle - -->
      <!-- skid 1: x[-0.145,0.145] y[-0.179,-0.164] z[-0.210,-0.205]; -->
      <!-- skid 2: x[-0.145,0.145] y[0.164,0.179] z[-0.210,-0.205]. -->
      <!-- Body block (central column, radius<0.10 from the stl's own -->
      <!-- vertices) spans z -0.005..0.09; approximated here as a 0.20x0.20 -->
      <!-- box (that radius) since it's not the exact body cross-section. -->
      <collision name="collision_base_link">
        <pose>0 0 0.0425 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.095</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_leg_left">
        <pose>0 -0.1715 -0.2075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.29 0.015 0.005</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_leg_right">
        <pose>0 0.1715 -0.2075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.29 0.015 0.005</size>
          </box>
        </geometry>
      </collision>

      <!-- Foot pads: 4 wider plates near the fore/aft ends of each thin skid
           rail, added on top of (not replacing) the rails above. Purely
           collision+visual widening for a more natural/stable footprint -
           bottom face held flush with the rails' own bottom (z=-0.2100) so
           the arm's ground-clearance margin (see hillstar_arm_clearance_stand)
           is unaffected. The STL's visual mesh already sculpts the thin
           skids and can't be edited (no xacro source), so these pads are
           purely additive primitives, not a mesh replacement. -->
      <collision name="collision_foot_pad_fl">
        <pose>0.115 -0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_foot_pad_bl">
        <pose>-0.115 -0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_foot_pad_fr">
        <pose>0.115 0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_foot_pad_br">
        <pose>-0.115 0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual_foot_pad_fl">
        <pose>0.115 -0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="visual_foot_pad_bl">
        <pose>-0.115 -0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="visual_foot_pad_fr">
        <pose>0.115 0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="visual_foot_pad_br">
        <pose>-0.115 0.1715 -0.207 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.05 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <visual name='visual_base_link'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
          <uri>model://hillstar/stl_files/body_frame_subassembly.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- Attachment mount boss: modeled as part of base_link itself (not a -->
      <!-- separate link+fixed-joint) so an attachment's joints (gripper, -->
      <!-- manipulator, etc.) can parent directly off base_link, matching the -->
      <!-- arm/prop joints elsewhere in this file - a revolute joint hanging -->
      <!-- off a link that is itself fixed-jointed to the root was found to -->
      <!-- silently not actuate. This boss is the shared physical mounting -->
      <!-- point every attachment model (see rigid_arm_3link, and hillstar's -->
      <!-- own embedded gripper) bolts its first joint to. -->
      <!-- Mounted flush under the actual body BLOCK (not the leg-inclusive -->
      <!-- collision envelope above): analyzing the mesh's own vertices -->
      <!-- (radius < 0.10 from the center axis, i.e. excluding the splayed -->
      <!-- legs/arm mounts) shows the block itself spans z -0.005..+0.09, so -->
      <!-- its real bottom is -0.005, not the legs' foot level (-0.21). -->
      <collision name="collision_gripper_mount">
        <pose>0 0 -0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
      <visual name="visual_gripper_mount">
        <pose>0 0 -0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- the sensors attached on the main body should go here -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <!-- Forward/down-looking RGB camera for future AprilTag-based -->
      <!-- perception. Rigidly mounted under the front of the body (no -->
      <!-- separate link/joint needed - it never moves relative to base_link), -->
      <!-- pitched 30 deg down from horizontal so it naturally frames the -->
      <!-- sloped wall ahead during a level approach. horizontal_fov=110deg -->
      <!-- with a 4:3 image was sized so the wall's full 5.5m width fits in -->
      <!-- frame from ~3.9m out (verified by computing the actual wall-corner -->
      <!-- angles from that standoff) - covering the whole 5.5m-wide wall from -->
      <!-- only ~1m away would need a ~170+ deg fisheye, which would badly -->
      <!-- distort the AprilTags right when you need them most accurate. -->
      <sensor name="camera_sensor" type="camera">
        <pose>0.1 0 -0.03 0 0.5236 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>hillstar/camera</topic>
        <camera>
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- ARM - 0 -->
    <!--  -->
    <!-- The link for individual arm assembly -->
    <link name = "arm_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.102 -0.102 0.02 0 0 0.785</pose>
      <inertial>
        <mass>0.2</mass>
          <inertia>
            <ixx>9.1e-4</ixx>
            <iyy>7.1e-5</iyy>
            <izz>9.1e-4</izz>
          </inertia>
      </inertial>
      <visual name='visual_arm_assembly_0'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.4 1.0</ambient>
          <diffuse>0.3 0.35 0.5 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
          <emissive>0.0 0.0 0.0 0.0</emissive>
        </material>
      </visual>
      <collision name='collision_arm_assembly_0'>
        <pose>0 -0.135 0 0 0 0</pose>
        <!-- origin is at the mounting point, shifting it to Center of Geometry -->
        <geometry>
          <box>
            <size>0.06 0.27 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- The joint for tilting arm_0 -->
    <joint name="tilt_arm_0" type="revolute">
      <parent>base_link</parent>
      <child>arm_0</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.5707</lower>
          <upper>1.5707</upper>
          <effort>3.5</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.025</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Control for the tilting motor-0 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_0</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_0</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <!-- Link for the propeller-0 -->
    <link name = "prop_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.28 -0.28 0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
          <inertia>
            <ixx>8.8e-07</ixx>
            <iyy>2.6e-04</iyy>
            <izz>2.6e-04</izz>
          </inertia>
      </inertial>
      <visual name='visual_prop_0'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_0'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joint for the propeller-0 -->
    <joint name="rotor_0_joint" type="revolute">
      <parent>arm_0</parent>
      <child>prop_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Motor object for the propeller-0 -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>prop_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.015</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>855</maxRotVelocity>
      <motorConstant>3.5e-5</motorConstant>
      <momentConstant>0.017</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- ARM - 1 -->
    <!--  -->
    <!-- The link for individual arm assembly -->
    <link name = "arm_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.102 0.102 0.02 0 0 -2.356</pose>
      <inertial>
        <mass>0.2</mass>
          <inertia>
            <ixx>9.1e-4</ixx>
            <iyy>7.1e-5</iyy>
            <izz>9.1e-4</izz>
          </inertia>
      </inertial>
      <visual name='visual_arm_assembly_1'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.4 1.0</ambient>
          <diffuse>0.3 0.35 0.5 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
          <emissive>0.0 0.0 0.0 0.0</emissive>
        </material>
      </visual>
      <collision name='collision_arm_assembly_1'>
        <pose>0 -0.135 0 0 0 0</pose>
        <!-- origin is at the mounting point, shifting it to Center of Geometry -->
        <geometry>
          <box>
            <size>0.06 0.27 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- The joint for tilting arm_1 -->
    <joint name="tilt_arm_1" type="revolute">
      <parent>base_link</parent>
      <child>arm_1</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.5707</lower>
          <upper>1.5707</upper>
          <effort>3.5</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.025</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Control for the tilting motor-1 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_1</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_1</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <!-- Link for the propeller-1 -->
    <link name = "prop_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.28 0.28 0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
          <inertia>
            <ixx>8.8e-07</ixx>
            <iyy>2.6e-04</iyy>
            <izz>2.6e-04</izz>
          </inertia>
      </inertial>
      <visual name='visual_prop_1'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_1'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joint for the propeller-1 -->
    <joint name="rotor_1_joint" type="revolute">
      <parent>arm_1</parent>
      <child>prop_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Motor object for the propeller-1 -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>prop_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.015</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>855</maxRotVelocity>
      <motorConstant>3.5e-5</motorConstant>
      <momentConstant>0.017</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>


    <!-- ARM - 2 -->
    <!--  -->
    <!-- The link for individual arm assembly -->
    <link name = "arm_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.102 0.102 0.02 0 0 2.356</pose>
      <inertial>
        <mass>0.2</mass>
          <inertia>
            <ixx>9.1e-4</ixx>
            <iyy>7.1e-5</iyy>
            <izz>9.1e-4</izz>
          </inertia>
      </inertial>
      <visual name='visual_arm_assembly_2'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.4 1.0</ambient>
          <diffuse>0.3 0.35 0.5 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
          <emissive>0.0 0.0 0.0 0.0</emissive>
        </material>
      </visual>
      <collision name='collision_arm_assembly_2'>
        <pose>0 -0.135 0 0 0 0</pose>
        <!-- origin is at the mounting point, shifting it to Center of Geometry -->
        <geometry>
          <box>
            <size>0.06 0.27 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- The joint for tilting arm_2 -->
    <joint name="tilt_arm_2" type="revolute">
      <parent>base_link</parent>
      <child>arm_2</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.5707</lower>
          <upper>1.5707</upper>
          <effort>3.5</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.025</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Control for the tilting motor-2 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_2</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_2</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <!-- Link for the propeller-2 -->
    <link name = "prop_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.28 0.28 0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
          <inertia>
            <ixx>8.8e-07</ixx>
            <iyy>2.6e-04</iyy>
            <izz>2.6e-04</izz>
          </inertia>
      </inertial>
      <visual name='visual_prop_2'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_2'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joint for the propeller-2 -->
    <joint name="rotor_2_joint" type="revolute">
      <parent>arm_2</parent>
      <child>prop_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Motor object for the propeller-2 -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>prop_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.015</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>855</maxRotVelocity>
      <motorConstant>3.5e-5</motorConstant>
      <momentConstant>0.017</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

        <!-- ARM - 3 -->
    <!--  -->
    <!-- The link for individual arm assembly -->
    <link name = "arm_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.102 -0.102 0.02 0 0 -0.785</pose>
      <inertial>
        <mass>0.2</mass>
          <inertia>
            <ixx>9.1e-4</ixx>
            <iyy>7.1e-5</iyy>
            <izz>9.1e-4</izz>
          </inertia>
      </inertial>
      <visual name='visual_arm_assembly_3'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/arm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.4 1.0</ambient>
          <diffuse>0.3 0.35 0.5 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
          <emissive>0.0 0.0 0.0 0.0</emissive>
        </material>
      </visual>
      <collision name='collision_arm_assembly_3'>
        <pose>0 -0.135 0 0 0 0</pose>
        <!-- origin is at the mounting point, shifting it to Center of Geometry -->
        <geometry>
          <box>
            <size>0.06 0.27 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- The joint for tilting arm_3 -->
    <joint name="tilt_arm_3" type="revolute">
      <parent>base_link</parent>
      <child>arm_3</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.5707</lower>
          <upper>1.5707</upper>
          <effort>3.5</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.025</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Control for the tilting motor-3 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_3</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_3</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <!-- Link for the propeller-3 -->
    <link name = "prop_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.28 -0.28 0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
          <inertia>
            <ixx>8.8e-07</ixx>
            <iyy>2.6e-04</iyy>
            <izz>2.6e-04</izz>
          </inertia>
      </inertial>
      <visual name='visual_prop_3'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_3'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joint for the propeller-3 -->
    <joint name="rotor_3_joint" type="revolute">
      <parent>arm_3</parent>
      <child>prop_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Motor object for the propeller-3 -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>prop_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.015</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>855</maxRotVelocity>
      <motorConstant>3.5e-5</motorConstant>
      <momentConstant>0.017</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/hillstar/tilt_angles</topic>
      <joint_name>tilt_arm_0</joint_name>
      <joint_name>tilt_arm_1</joint_name>
      <joint_name>tilt_arm_2</joint_name>
      <joint_name>tilt_arm_3</joint_name>
    </plugin>

  </model>
</sdf>
