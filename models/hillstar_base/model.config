<?xml version="1.0"?>
<model>
  <name>hillstar_base</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Aabhash Bhandari</name>
  </author>

  <description>
    Hillstar_v2 vehicle-only base: frame, 4 tilting rotor arms, and sensors.
    No end-effector attached. Meant to be composed with an attachment model
    (e.g. rigid_arm_3link) via &lt;include merge='true'&gt; to build a
    complete vehicle variant - see hillstar_rigid_arm/model.sdf for the
    composition, and hillstar/model.sdf for the original monolithic
    (base + soft gripper) vehicle this was extracted from.
    Visual meshes are intentionally referenced from the sibling `hillstar`
    model (model://hillstar/stl_files/...) rather than duplicated here.
  </description>
</model>
