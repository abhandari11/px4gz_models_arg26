<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hillstar_rigid_arm'>
    <!-- Composition, not a hand-authored vehicle: hillstar_base supplies the
         frame/rotors/sensors, rigid_arm_3link supplies the manipulator. The
         one piece that can't live inside either included model is the joint
         that connects them - sdformat validates a merge='true' include's
         joints against its own document before splicing it in, so a joint
         referencing a link from the *other* include has to be declared here,
         in the file that has already merged both sides in (same pattern
         x500_mono_cam/x500_depth use for their own CameraJoint). To fly
         Hillstar with a different attachment, add a sibling composed model
         the same way: two <include merge='true'> lines plus its own glue
         joint. -->
    <include merge='true'>
      <uri>model://hillstar</uri>
    </include>
    <include merge='true'>
      <uri>model://rigid_arm_3link</uri>
    </include>

    <!-- Glue joint: mounts the manipulator's first link onto the vehicle
         body, at the same boss the gripper attachment bolts to
         (hillstar_base's collision_gripper_mount/visual_gripper_mount, z
         -0.015 in base_link's frame). Revolute, same as joint_2/3: all 3
         joints (shoulder/elbow/wrist) are actuated, giving the manipulator
         3 DOF. Axis/limit/dynamics mirror rigid_arm_joint_2/3 exactly.
         Driven by rigid_arm_3link's own JointTrajectoryController/
         JointStatePublisher plugins even though the joint itself is
         declared here - see rigid_arm_3link/model.sdf's header comment for
         why that's safe (plugin <joint_name> lookups resolve against the
         merged model at runtime, not the original per-module document). -->
    <joint name="rigid_arm_joint_1" type="revolute">
      <parent>base_link</parent>
      <child>rigid_arm_3link/link_1</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-2.0944</lower>
          <upper>2.0944</upper>
          <effort>0.6</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
  </model>
</sdf>
