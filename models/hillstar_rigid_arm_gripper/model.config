<?xml version="1.0"?>
<model>
  <name>hillstar_rigid_arm_gripper</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Aabhash Bhandari</name>
  </author>

  <description>
    Hillstar_v2 composed with BOTH attachments at once: rigid_arm_3link
    mounted on base_link (same as hillstar_rigid_arm), with gripper_3finger
    mounted at the tip of the arm's last link (rigid_arm_3link/link_3)
    instead of directly on base_link (the way hillstar_gripper does it).
    Gives a manipulator that can reach away from the airframe body and grasp
    with the 3-finger gripper at its tip. Same command/state topics as
    hillstar_gripper (gripper) and hillstar_rigid_arm (arm joints), just
    scoped to this model's own name.
  </description>
</model>
