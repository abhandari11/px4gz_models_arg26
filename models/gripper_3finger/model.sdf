<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!--
    Self-contained finger set for the 3-finger gripper attachment, plus a
    palm base (see below) that visually/physically connects the 3 fingers -
    without it, the fingers are separate joint-mounted links with nothing
    between them, which reads as "floating" fingers rather than a single
    gripper assembly. See model.config for why the mount joints and the
    GripperController plugin live in the composing file instead of here.
  -->
  <model name='gripper_3finger'>
    <!-- hillstar_base's own <model> carries a <pose>0 0 0.30 0 0 0</pose>
         that a merge='true' include bakes onto base_link's effective
         position, but NOT onto any other model merged alongside it - so
         without a matching pose here, the finger poses below (authored
         relative to base_link, e.g. z=-0.025 meaning "0.025m under the
         mount boss") would actually land 0.3m too low once merged into a
         vehicle, well below the landing legs. Mirroring the same offset
         here keeps this module's own poses correctly base_link-relative
         regardless of what it's composed into. -->
    <pose>0 0 0.30 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Palm base: a short cylinder spanning from the mount boss (z=0, this
         module's own origin) down to where the fingers start (z=-0.025,
         matching every finger link's own origin - see each finger's <pose>
         below), radius 0.045 so it clears the fingers' own 0.035m mount
         radius plus their box cross-section. Purely a physical/visual
         connector, like the gripper_3finger/finger_* links it needs a glue
         joint from the composing file (parent=base_link for hillstar_gripper,
         parent=rigid_arm_3link/link_3 for hillstar_rigid_arm_gripper) -
         same reasoning as the finger joints, see model.config. -->
    <link name="gripper_3finger/palm">
      <pose>0 0 -0.0125 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>8.375e-6</ixx>
          <iyy>8.375e-6</iyy>
          <izz>1.519e-5</izz>
        </inertia>
      </inertial>
      <collision name="gripper_3finger/palm_collision">
        <geometry>
          <cylinder><radius>0.045</radius><length>0.025</length></cylinder>
        </geometry>
      </collision>
      <visual name="gripper_3finger/palm_visual">
        <geometry>
          <cylinder><radius>0.045</radius><length>0.025</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.25 0.25 0.28 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <!-- Finger 0 - mount angle 0 deg -->
    <link name="gripper_3finger/finger_0">
      <pose>0.035 0 -0.025 0 0 0</pose>
      <gravity>true</gravity>
      <velocity_decay/>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.2e-6</ixx>
          <iyy>2.2e-6</iyy>
          <izz>2.5e-7</izz>
        </inertia>
      </inertial>
      <collision name="gripper_3finger/finger_0_collision">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
      </collision>
      <visual name="gripper_3finger/finger_0_visual">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.9 1</ambient>
          <diffuse>0.15 0.25 0.95 1</diffuse>
        </material>
      </visual>
      <sensor name="gripper_3finger/finger_0_contact_sensor" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>gripper_3finger/finger_0_collision</collision>
          <topic>/gripper_3finger/finger_0_contact</topic>
        </contact>
      </sensor>
    </link>

    <!-- Finger 1 - mount angle 120 deg -->
    <link name="gripper_3finger/finger_1">
      <pose>-0.0175 0.03031 -0.025 0 0 2.0944</pose>
      <gravity>true</gravity>
      <velocity_decay/>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.2e-6</ixx>
          <iyy>2.2e-6</iyy>
          <izz>2.5e-7</izz>
        </inertia>
      </inertial>
      <collision name="gripper_3finger/finger_1_collision">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
      </collision>
      <visual name="gripper_3finger/finger_1_visual">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.9 1</ambient>
          <diffuse>0.15 0.25 0.95 1</diffuse>
        </material>
      </visual>
      <sensor name="gripper_3finger/finger_1_contact_sensor" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>gripper_3finger/finger_1_collision</collision>
          <topic>/gripper_3finger/finger_1_contact</topic>
        </contact>
      </sensor>
    </link>

    <!-- Finger 2 - mount angle 240 deg -->
    <link name="gripper_3finger/finger_2">
      <pose>-0.0175 -0.03031 -0.025 0 0 4.1888</pose>
      <gravity>true</gravity>
      <velocity_decay/>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.2e-6</ixx>
          <iyy>2.2e-6</iyy>
          <izz>2.5e-7</izz>
        </inertia>
      </inertial>
      <collision name="gripper_3finger/finger_2_collision">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
      </collision>
      <visual name="gripper_3finger/finger_2_visual">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box><size>0.01 0.015 0.11</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.9 1</ambient>
          <diffuse>0.15 0.25 0.95 1</diffuse>
        </material>
      </visual>
      <sensor name="gripper_3finger/finger_2_contact_sensor" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>gripper_3finger/finger_2_collision</collision>
          <topic>/gripper_3finger/finger_2_contact</topic>
        </contact>
      </sensor>
    </link>

  </model>
</sdf>
