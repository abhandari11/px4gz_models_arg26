    <!-- Kinematic actuation: converts a commanded 3-tendon length vector into
         per-axis target bend angles for every joint above (constant-curvature
         discretization) and drives them with a PD force loop layered on top
         of the passive spring dynamics declared per-joint.

         effort_limit (here and on every joint's own <limit><effort> above)
         is derived the same way as continuum_arm_cosserat's: max_tension *
         pitch_radius = 16N * 0.015m = 0.24 N*m - the max torque the shared
         servo/tendon actuation can realistically deliver to any one joint,
         so both models saturate the physics joints at the same servo-
         derived torque ceiling. Unlike Cosserat's max_tension, this
         doesn't reflect a buckling limit (PCC's kinematic model has no
         notion of axial tendon load or column buckling at all) - it's
         purely an actuator-realism cap on the PD force layer, and in
         practice isn't the binding constraint on PCC's own reachable bend
         range (that's set by the commanded tendon-length magnitude, not
         by this limit - see continuum_arm_cosserat/model.sdf's plugin
         comment for why the two models' reachable ranges differ).

         command_filter_omega / max_tendon_rate_m_s (2026-08 open-loop
         retune): raw tendon commands no longer jump the target instantly -
         they're shaped by a critically-damped 2nd-order filter (see
         plugins/common/CommandShaper.hpp) before feeding UpdateTargets().
         omega=2.92 rad/s is the closed-form value for ~2% settling in
         ~2.0s (omega*ts~=5.83 for a critically-damped step); max_tendon_
         rate_m_s=0.06 m/s is a generous actuator-rate safety cap that
         stays inactive at the live-verified 75deg calibration step
         (single-tendon shorten of 0.044m, peak filtered rate there is
         ~0.047 m/s, below the 0.06 cap) and only engages on much larger
         commands. Live-verified (gz bench harness, sim-time-based
         measurement): 73.9deg reached in 1.91s, ~0% overshoot. Both omega
         and the rate cap are shared, by construction, with
         continuum_arm_cosserat's identical filter so the two models' open-
         loop step responses are directly comparable - see
         docs/continuum_arm_three_model_report.md. -->
    <plugin filename="TendonArmController" name="tendon_arm_controller::TendonArmController">
      <joint_name>continuum_arm_pcc/joint_1</joint_name>
      <joint_name>continuum_arm_pcc/joint_2</joint_name>
      <joint_name>continuum_arm_pcc/joint_3</joint_name>
      <joint_name>continuum_arm_pcc/joint_4</joint_name>
      <joint_name>continuum_arm_pcc/joint_5</joint_name>
      <joint_name>continuum_arm_pcc/joint_6</joint_name>
      <joint_name>continuum_arm_pcc/joint_7</joint_name>
      <joint_name>continuum_arm_pcc/joint_8</joint_name>
      <joint_name>continuum_arm_pcc/joint_9</joint_name>
      <joint_name>continuum_arm_pcc/joint_10</joint_name>
      <joint_name>continuum_arm_pcc/joint_11</joint_name>
      <joint_name>continuum_arm_pcc/joint_12</joint_name>
      <joint_name>continuum_arm_pcc/joint_13</joint_name>
      <joint_name>continuum_arm_pcc/joint_14</joint_name>
      <joint_name>continuum_arm_pcc/joint_15</joint_name>
      <pitch_radius>0.015</pitch_radius>
      <rest_length>0.4</rest_length>
      <position_p_gain>5.0</position_p_gain>
      <position_d_gain>0.05</position_d_gain>
      <effort_limit>0.24</effort_limit>
      <tendon_topic>/continuum_arm_pcc/tendon_cmd</tendon_topic>
      <angles_topic>/continuum_arm_pcc/bend_angles</angles_topic>
      <command_filter_omega>2.92</command_filter_omega>
      <max_tendon_rate_m_s>0.06</max_tendon_rate_m_s>
    </plugin>

    <!-- Joint state feedback (actual, physics-integrated angles), same
         pattern rigid_arm_3link uses - lets the test script verify the arm
         actually bent the way the tendon command intended. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/continuum_arm_pcc/joint_states</topic>
      <joint_name>continuum_arm_pcc/joint_1</joint_name>
      <joint_name>continuum_arm_pcc/joint_2</joint_name>
      <joint_name>continuum_arm_pcc/joint_3</joint_name>
      <joint_name>continuum_arm_pcc/joint_4</joint_name>
      <joint_name>continuum_arm_pcc/joint_5</joint_name>
      <joint_name>continuum_arm_pcc/joint_6</joint_name>
      <joint_name>continuum_arm_pcc/joint_7</joint_name>
      <joint_name>continuum_arm_pcc/joint_8</joint_name>
      <joint_name>continuum_arm_pcc/joint_9</joint_name>
      <joint_name>continuum_arm_pcc/joint_10</joint_name>
      <joint_name>continuum_arm_pcc/joint_11</joint_name>
      <joint_name>continuum_arm_pcc/joint_12</joint_name>
      <joint_name>continuum_arm_pcc/joint_13</joint_name>
      <joint_name>continuum_arm_pcc/joint_14</joint_name>
      <joint_name>continuum_arm_pcc/joint_15</joint_name>
    </plugin>

  </model>
</sdf>
