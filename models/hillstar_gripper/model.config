<?xml version="1.0"?>
<model>
  <name>hillstar_gripper</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Aabhash Bhandari</name>
  </author>

  <description>
    Hillstar_v2 composed with the gripper_3finger attachment
    (hillstar_base + gripper_3finger, merged). Behaviorally equivalent to
    the original monolithic `hillstar` model (same command/state topics,
    same grasp behavior) - built the modular way, as a sibling of
    hillstar_rigid_arm, instead of having the gripper baked directly into
    the vehicle. Launched via the 4024_gz_hillstar_gripper airframe
    (PX4_SIM_MODEL=hillstar_gripper), same as `make px4_sitl
    gz_hillstar_gripper`. The original `hillstar` model is left in place,
    untouched, for backward compatibility.
  </description>
</model>
