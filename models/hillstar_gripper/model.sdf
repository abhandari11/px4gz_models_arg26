<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hillstar_gripper'>
    <!-- Composition: hillstar_base supplies the frame/rotors/sensors,
         gripper_3finger supplies the 3 finger links. Everything that
         references something *outside* gripper_3finger's own document has
         to live here instead of inside that module (same reasoning as
         hillstar_rigid_arm's glue joint):
           - all 3 finger joints parent onto "base_link" (foreign link,
             fails sdformat's per-document frame-graph check if declared
             inside gripper_3finger - verified the same way as the rigid
             arm's shoulder joint);
           - GripperController's <vehicle_model_name> must equal this
             composed model's own name ("hillstar_gripper"), which can't be
             hardcoded inside a module meant to be reusable as-is. Getting
             this wrong wouldn't error at load time - it would silently
             break the "don't grasp myself" check in
             GripperController::TryGrasp(), since that check simply
             wouldn't match any real spawned model name. -->
    <include merge='true'>
      <uri>model://hillstar</uri>
    </include>
    <include merge='true'>
      <uri>model://gripper_3finger</uri>
    </include>

    <!-- Glue joint: welds the palm base (gripper_3finger/palm) onto the
         vehicle body at the same mount boss the fingers hang from. Fixed,
         not revolute - it's a static connector, not an actuated part. -->
    <joint name="palm_joint" type="fixed">
      <parent>base_link</parent>
      <child>gripper_3finger/palm</child>
    </joint>

    <!-- Glue joints: mount each finger onto the vehicle body. Axis/limit/
         dynamics are unchanged from the original monolithic hillstar. -->
    <joint name="finger_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>gripper_3finger/finger_0</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>0.5</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.005</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="finger_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>gripper_3finger/finger_1</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>0.5</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.005</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="finger_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>gripper_3finger/finger_2</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>0.5</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.005</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Custom grasp controller: single open/close command -> finger motion,
         dynamic object search/attach on close, detach on open, state
         feedback.
         Conditions for a succesful grasp:
         1. the object isnt the vehicle itself and isnt static
         2. its canonical-link position is within grasp_radius of the computed grasp_center (base_link + grasp_center_offset)
         3. its in contact with at least one finger's collison box
         -->
    <plugin filename="GripperController" name="gripper_controller::GripperController">
      <gripper_base_link>base_link</gripper_base_link>
      <finger_joint>finger_0_joint</finger_joint>
      <finger_joint>finger_1_joint</finger_joint>
      <finger_joint>finger_2_joint</finger_joint>
      <finger_collision>gripper_3finger/finger_0_collision</finger_collision>
      <finger_collision>gripper_3finger/finger_1_collision</finger_collision>
      <finger_collision>gripper_3finger/finger_2_collision</finger_collision>
      <finger_contact_topic>/gripper_3finger/finger_0_contact</finger_contact_topic>
      <finger_contact_topic>/gripper_3finger/finger_1_contact</finger_contact_topic>
      <finger_contact_topic>/gripper_3finger/finger_2_contact</finger_contact_topic>
      <!-- open = fingers spread outward, ready to grab; closed = fingers
           curled toward center, object grasped; 30 deg from vertical. -->
      <open_position>0.5235</open_position>
      <closed_position>-0.5235</closed_position>
      <finger_p_gain>1.5</finger_p_gain>
      <finger_d_gain>0.02</finger_d_gain>
      <finger_effort_limit>0.5</finger_effort_limit>
      <command_topic>/hillstar/gripper_cmd</command_topic>
      <state_topic>/hillstar/gripper_state</state_topic>
      <grasp_radius>0.25</grasp_radius>
      <!-- world-Z offset of the gripper's capture point, relative to
           base_link's own origin. 7.2 cm below frame base
           Gazebo frame is Z-up -->
      <grasp_center_offset>0 0 0.074</grasp_center_offset>
      <vehicle_model_name>hillstar_gripper</vehicle_model_name>
    </plugin>
  </model>
</sdf>
