<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!--
    3-tendon soft continuum arm, discretized as N=15 rigid cylindrical
    segments (total length L=0.30m, 0.02m per segment) coupled by 2-DOF
    universal joints (axis=X, axis2=Y bending). Passive silicone compliance
    is modeled with native joint spring dynamics on every axis
    (K_theta = 1.25 N*m/rad, damping 0.08); active bending comes from
    TendonArmController, which converts a commanded 3-tendon length vector
    (l1,l2,l3) into constant-curvature target angles (theta_x, theta_y) via
    the standard 3-tendon Jacobian and drives every joint axis toward
    theta_x/N, theta_y/N with a PD force loop layered on top of the passive
    spring (see plugins/tendon_arm_controller).

    Each segment link's own origin is at its geometric center; joints are
    offset (child-relative pose, +half segment length along local Z) up to
    the proximal/top face of that segment, where it welds to the previous
    segment's (or the base cylinder's) bottom face. Arm hangs along -Z from
    the base cylinder's bottom face, matching a bottom-mounted attachment.

    Mount contract: continuum_arm_soft/base_cyl is this module's own
    attachment point, its top face (z=0 in this file's frame) is the
    mounting interface. Composing this onto a vehicle (e.g. hillstar) needs
    one glue joint (parent=<vehicle base link>, child=
    continuum_arm_soft/base_cyl), the same pattern rigid_arm_3link and
    hillstar_rigid_arm use - see that model's header comment for why the
    joint must be declared in the composing file rather than in here.
  -->
  <model name='continuum_arm_soft'>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="continuum_arm_soft/base_cyl">
      <pose>0 0 -0.01000 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.120637</mass>
        <inertia>
          <ixx>5.227610e-05</ixx>
          <iyy>5.227610e-05</iyy>
          <izz>9.650973e-05</izz>
        </inertia>
      </inertial>
      <collision name="continuum_arm_soft/base_cyl_collision">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
      <visual name="continuum_arm_soft/base_cyl_visual">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.08 0.20 1</ambient>
          <diffuse>0.08 0.12 0.30 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
    <!-- Segment 1/15 -->
    <link name="continuum_arm_soft/segment_1">
      <pose>0 0 -0.03000 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.027646</mass>
        <inertia>
          <ixx>3.686135e-06</ixx>
          <iyy>3.686135e-06</iyy>
          <izz>5.529203e-06</izz>
        </inertia>
      </inertial>
      <collision name="continuum_arm_soft/segment_1_collision">
        <geometry>
          <cylinder><radius>0.02</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
      <visual name="continuum_arm_soft/segment_1_visual">
        <geometry>
          <cylinder><radius>0.02</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.050 0.080 0.350 1</ambient>
          <diffuse>0.080 0.150 0.550 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
    <joint name="continuum_arm_soft/joint_1" type="universal">
      <parent>continuum_arm_soft/base_cyl</parent>
      <child>continuum_arm_soft/segment_1</child>
      <pose>0 0 0.01000 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>0.6</effort>
          <velocity>5.0</velocity>
        </limit>
        <dynamics>
          <spring_stiffness>1.25</spring_stiffness>
          <spring_reference>0.0</spring_reference>
          <damping>0.08</damping>
        </dynamics>
      </axis>
      <axis2>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>0.6</effort>
