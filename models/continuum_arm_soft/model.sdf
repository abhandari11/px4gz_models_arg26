    <!-- Kinematic actuation: converts a commanded 3-tendon length vector into
         per-axis target bend angles for every joint above (constant-curvature
         discretization) and drives them with a PD force loop layered on top
         of the passive spring dynamics declared per-joint. -->
    <plugin filename="TendonArmController" name="tendon_arm_controller::TendonArmController">
      <joint_name>continuum_arm_soft/joint_1</joint_name>
      <joint_name>continuum_arm_soft/joint_2</joint_name>
      <joint_name>continuum_arm_soft/joint_3</joint_name>
      <joint_name>continuum_arm_soft/joint_4</joint_name>
      <joint_name>continuum_arm_soft/joint_5</joint_name>
      <joint_name>continuum_arm_soft/joint_6</joint_name>
      <joint_name>continuum_arm_soft/joint_7</joint_name>
      <joint_name>continuum_arm_soft/joint_8</joint_name>
      <joint_name>continuum_arm_soft/joint_9</joint_name>
      <joint_name>continuum_arm_soft/joint_10</joint_name>
      <joint_name>continuum_arm_soft/joint_11</joint_name>
      <joint_name>continuum_arm_soft/joint_12</joint_name>
      <joint_name>continuum_arm_soft/joint_13</joint_name>
      <joint_name>continuum_arm_soft/joint_14</joint_name>
      <joint_name>continuum_arm_soft/joint_15</joint_name>
      <pitch_radius>0.018</pitch_radius>
      <rest_length>0.3</rest_length>
      <position_p_gain>5.0</position_p_gain>
      <position_d_gain>0.05</position_d_gain>
      <effort_limit>0.6</effort_limit>
      <tendon_topic>/continuum_arm_soft/tendon_cmd</tendon_topic>
      <angles_topic>/continuum_arm_soft/bend_angles</angles_topic>
    </plugin>

    <!-- Joint state feedback (actual, physics-integrated angles), same
         pattern rigid_arm_3link uses - lets the test script verify the arm
         actually bent the way the tendon command intended. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/continuum_arm_soft/joint_states</topic>
      <joint_name>continuum_arm_soft/joint_1</joint_name>
      <joint_name>continuum_arm_soft/joint_2</joint_name>
      <joint_name>continuum_arm_soft/joint_3</joint_name>
      <joint_name>continuum_arm_soft/joint_4</joint_name>
      <joint_name>continuum_arm_soft/joint_5</joint_name>
      <joint_name>continuum_arm_soft/joint_6</joint_name>
      <joint_name>continuum_arm_soft/joint_7</joint_name>
      <joint_name>continuum_arm_soft/joint_8</joint_name>
      <joint_name>continuum_arm_soft/joint_9</joint_name>
      <joint_name>continuum_arm_soft/joint_10</joint_name>
      <joint_name>continuum_arm_soft/joint_11</joint_name>
      <joint_name>continuum_arm_soft/joint_12</joint_name>
      <joint_name>continuum_arm_soft/joint_13</joint_name>
      <joint_name>continuum_arm_soft/joint_14</joint_name>
      <joint_name>continuum_arm_soft/joint_15</joint_name>
    </plugin>

