<?xml version="1.0"?>
<model>
  <name>rigid_arm_3link</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Aabhash Bhandari</name>
  </author>

  <description>
    Lightweight 3-link rigid manipulator built from primitive geometry
    (cylindrical rods, no meshes). Each link is ~15cm long; all 3 joints are
    1-DOF revolute, rotating about the UAV pitch axis. Attaches onto any
    base model that exposes a "base_link" via one small glue joint added by
    the composing file (see hillstar_rigid_arm/model.sdf).
    At the joints' zero position the whole arm folds aft and level so it
    stays clear of the ground when the base is landed on its legs.
    Actuated by the stock gz-sim JointTrajectoryController (hybrid
    position+velocity tracking) and publishes joint states via
    JointStatePublisher. See hillstar_rigid_arm/model.sdf for how this is
    composed onto hillstar_base, and hillstar_px4's rigid_arm_client.py for
    the ROS 2 side.
  </description>
</model>
