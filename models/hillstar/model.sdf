        <!-- ARM - 3 -->
    <!--  -->
    <!-- The link for individual arm assembly -->
    <link name = "arm_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.102 -0.102 0.02 0 0 -0.785</pose>
