        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_1'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joint for the propeller-1 -->
    <joint name="rotor_1_joint" type="revolute">
      <parent>arm_1</parent>
      <child>prop_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Motor object for the propeller-1 -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>prop_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.015</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>855</maxRotVelocity>
      <motorConstant>3.5e-5</motorConstant>
      <momentConstant>0.017</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>


