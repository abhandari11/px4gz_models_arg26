        </dynamics>
      </axis>
    </joint>  
    
    <!-- Joint Control for the tilting motor-2 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_2</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_2</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>
    
    <!-- Link for the propeller-2 -->
    <link name = "prop_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.28 0.28 0.06 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
          <inertia>
            <ixx>8.8e-07</ixx>
            <iyy>2.6e-04</iyy>
            <izz>2.6e-04</izz>
          </inertia>
      </inertial>
      <visual name='visual_prop_2'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.32 0.36 1</ambient>
          <diffuse>0.6 0.65 0.8 1</diffuse>
          <specular>0.4 0.45 0.55 1</specular>
        </material>
      </visual>
      <collision name='collision_prop_2'>
        <geometry>
          <mesh>
            <uri>model://hillstar/stl_files/prop.stl</uri>
          </mesh>
        </geometry>
      </collision>      
    </link>

    <!-- Joint for the propeller-2 -->
    <joint name="rotor_2_joint" type="revolute">
      <parent>arm_2</parent>
      <child>prop_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
