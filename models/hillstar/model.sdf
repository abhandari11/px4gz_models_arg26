          <effort>3.5</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.025</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Control for the tilting motor-1 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_arm_1</joint_name>
      <initial_position>0</initial_position>
      <sub_topic>servo_1</sub_topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
