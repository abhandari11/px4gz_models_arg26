        <geometry>
          <box>
            <size>0.06 0.27 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- The joint for tilting arm_2 -->
    <joint name="tilt_arm_2" type="revolute">
      <parent>base_link</parent>
      <child>arm_2</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
