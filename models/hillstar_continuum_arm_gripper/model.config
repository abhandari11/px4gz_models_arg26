<?xml version="1.0"?>
<model>
  <name>hillstar_continuum_arm_gripper</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Aabhash Bhandari</name>
  </author>

  <description>
    Hillstar_v2 composed with a soft continuum manipulator: continuum_arm_cosserat
    (15-segment, 0.40m, 3-tendon soft arm, full dynamic Cosserat-rod actuation
    via CosseratArmController) mounted on base_link's underside, with
    gripper_3finger mounted at the tip of the arm's last segment
    (continuum_arm_cosserat/segment_15) instead of directly on base_link (the
    way hillstar_gripper does it). Gives a manipulator that can bend away from
    the airframe body under tendon-space control and grasp with the
    3-finger gripper at its tip.

    Same command/state topics as hillstar_gripper (gripper open/close) and
    continuum_arm_cosserat (tendon command / bend angles / joint states), just
    scoped to this model's own name where applicable.
  </description>
</model>
