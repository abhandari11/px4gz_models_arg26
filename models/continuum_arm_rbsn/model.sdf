<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!--
    Non-linear Rigid-Body Spring Network (RBSN) continuum arm: same
    physical arm/geometry as continuum_arm_pcc and continuum_arm_cosserat
    (Ø40mm OD / Ø30mm ID lattice-TPU tube, N=15 rigid segments, total
    length L=0.40m, ~26.67mm per segment, 2-DOF universal joints), but the
    THIRD, architecturally distinct mechanics model: neither PCC's
    kinematic PD-position-tracking nor Cosserat's quasi-static BVP+PD-
    tracking - RBSN runs genuine forward dynamics. Every joint carries its
    own non-linear elastic restoring torque
    tau_spring(theta) = k1*theta + k2*theta^3 plus linear viscous damping
    (native gz-sim joint damping, no SDF spring_stiffness at all - matching
    continuum_arm_cosserat's convention of keeping elasticity out of the
    passive SDF joint and inside the controller instead), and tendon
    tension is converted DIRECTLY into a generalized actuation torque
    (not a solved/kinematic position target) via the tendon-routing
    Jacobian's transpose - see plugins/rbsn_arm_controller's header
    comment for the exact derivation. The resulting bend is a genuine
    dynamic equilibrium (actuation torque balances the non-linear spring),
    not something teleported into place by a position controller.

    Active bending comes from RbsnArmController (see
    plugins/rbsn_arm_controller), which converts a commanded 3-tendon
    length vector (l1,l2,l3, pitch radius = tendon routing radius = 15mm =
    ID/2, matching the 3 tendons run along the inner wall's 30mm-diameter
    circle, 120deg apart) into pulling tensions, then into torque, split
    evenly across the 15 joints (same even-distribution convention
    PCC/Cosserat both use for their own actuation targets).

    Each segment link's own origin is at its geometric center; joints are
    offset (child-relative pose, +half segment length along local Z) up to
    the proximal/top face of that segment, where it welds to the previous
    segment's (or the base cylinder's) bottom face. Arm hangs along -Z from
    the base cylinder's bottom face, matching a bottom-mounted attachment.

    Mass budget: total assembly (base + 15 segments) is ~250g, split as
    m_base=78.43g + 15*m_seg=11.44g = 250.00g, using the
    same uniform effective density (780.2 kg/m^3, lattice-infill TPU) as
    continuum_arm_pcc/continuum_arm_cosserat - identical geometry/mass
    budget across all three models is the whole point of a fair head-to-
    head comparison (see docs/continuum_arm_three_model_report.md).

    Mount contract: continuum_arm_rbsn/base_cyl is this module's own
    attachment point, its top face (z=0 in this file's frame) is the
    mounting interface. Composing this onto a vehicle (e.g. hillstar) needs
    one glue joint (parent=<vehicle base link>, child=
    continuum_arm_rbsn/base_cyl), the same pattern rigid_arm_3link and
    hillstar_rigid_arm use - see that model's header comment for why the
    joint must be declared in the composing file rather than in here.
  -->
  <model name='continuum_arm_rbsn'>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="continuum_arm_rbsn/base_cyl">
      <pose>0 0 -0.01000 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.078431</mass>
        <inertia>
          <ixx>3.398693e-05</ixx>
          <iyy>3.398693e-05</iyy>
          <izz>6.274510e-05</izz>
        </inertia>
      </inertial>
      <collision name="continuum_arm_rbsn/base_cyl_collision">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
      <visual name="continuum_arm_rbsn/base_cyl_visual">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.20 0.08 1</ambient>
          <diffuse>0.08 0.30 0.12 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
    <!-- Segment 1/15 -->
    <link name="continuum_arm_rbsn/segment_1">
      <pose>0 0 -0.03333 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.011438</mass>
        <inertia>
          <ixx>2.464975e-06</ixx>
          <iyy>2.464975e-06</iyy>
          <izz>3.574346e-06</izz>
